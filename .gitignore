# ============================================================
# .gitignore — Solar Flare AI Accelerator
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Large binary / data files (keep CSVs, exclude raw NetCDF + model weights)
data/raw/*.nc
*.pt
*.ckpt

# Keep INT8 weights npz (small, 11 KB) — tracked
# models/flare_1dcnn_int8_weights.npz  ← NOT ignored

# OpenLane intermediate run artifacts (keep final/ results)
asic/openlane/runs/*/tmp/
asic/openlane/runs/*/logs/
asic/openlane/runs/*/*.log

# Verilog simulation outputs
*.vcd
*.vvp
sim.out

# Synthesis intermediate files
*.synth.v.bak
netlist/

# Virtual env Python cache
*.pyc

# Legacy / old docs
"Solar_Flare_AI_Accelerator_Project_Report (2).md"
cadence_scripts/
asic/cadence/
